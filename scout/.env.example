# Optional. Without it, Scout still works: the barcode scanner, venue search,
# seed data, and ingredient matching all run without any API call. Only the
# menu substitution engine uses it, and it degrades to matcher-only output.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5.
SCOUT_MODEL=

# Optional. Defaults to ./scout.db
SCOUT_DB_PATH=

# Required etiquette for the OpenStreetMap endpoints: identify your deployment.
# Nominatim and Overpass block generic and absent User-Agents.
SCOUT_USER_AGENT=Scout/0.1 (ingredient transparency app; you@example.com)
